{
  "name": "doc-karta",
  "version": "0.0.0",
  "private": true,
  "description": "Living, graph-based documentation viewer for monorepos",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "core:build": "cargo build -p karta-core",
    "core:test": "cargo test -p karta-core"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
